  "dependencies": {
    "@expo-google-fonts/public-sans": "catalog:",
    "@gorhom/bottom-sheet": "catalog:",
    "@tellipod/ui-kit": "workspace:*",
    "expo": "catalog:",
    "expo-blur": "catalog:",
    "expo-constants": "catalog:",
    "expo-font": "catalog:",
    "expo-linking": "catalog:",
    "expo-router": "catalog:",
    "expo-system-ui": "catalog:",
    "jotai": "catalog:",
    "nativewind": "catalog:",
    "react": "catalog:",
    "react-native": "catalog:",
    "react-native-css-interop": "catalog:",
    "react-native-gesture-handler": "catalog:",
    "react-native-reanimated": "catalog:",
    "react-native-safe-area-context": "catalog:",
    "react-native-screens": "catalog:",
    "react-native-svg": "catalog:",
    "react-native-worklets": "catalog:"
  },
  "devDependencies": {
    "@babel/core": "catalog:",
    "@react-native/jest-preset": "catalog:",
    "@testing-library/react-native": "catalog:",
    "@types/jest": "catalog:",
    "@types/react": "catalog:",
    "babel-preset-expo": "catalog:",
    "jest": "catalog:",
    "jest-expo": "catalog:",
    "tailwindcss": "catalog:",
    "test-renderer": "catalog:"
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/"
    ],
    "moduleNameMapper": {
      "\\.svg$": "<rootDir>/../../packages/ui-kit/jest/svgMock.js"
    }
  }
